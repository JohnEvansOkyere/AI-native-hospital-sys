# Copy this to .env and fill in your keys

# ── Runtime mode and staff access ────────────────────────────────────────────
# Local default: development, demo simulator + relative seed data enabled.
# Clinic deployment: set production. This disables demo tools and seed data and
# makes missing PostgreSQL, Meta signature, cron and reminder settings launch-blocking.
# APP_ENV=production
# ENABLE_DEMO_TOOLS=0
# DEMO_SEED=0
# CORS_ORIGINS=https://care.yourclinic.com

# On the first production boot, create the initial administrator from these
# values. Later boots ignore them once a staff account exists. Use a unique
# password of at least 12 characters, then rotate/remove the password variable.
# BOOTSTRAP_ADMIN_EMAIL=admin@yourclinic.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Clinic Administrator

# Required for AI-powered reason detection and report generation
# Get a free key at https://console.groq.com (cheap + fast)
# This file is a TEMPLATE and is committed — never put a real key here.
GROQ_API_KEY=

# Optional model overrides (defaults are good for the demo)
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_REPORT_MODEL=llama-3.3-70b-versatile

# ── Speech-to-text (voice notes + the code-switch benchmark) ──────────────────
# All optional. With none set, the app falls back to local faster-whisper; with
# nothing at all it degrades to "I couldn't hear that, please type it".
# INTRON_API_KEY=          # Intron Sahara — https://voice.intron.io/v2/developers
# KHAYA_API_KEY=           # GhanaNLP Khaya — https://translation.ghananlp.org
#                          # One key covers ASR (Twi/Ga/Ewe), translation AND the
#                          # only real Twi/Ewe TTS voices we have. Probe what your
#                          # key actually serves first: benchmark/probe_khaya.py
# CARTESIA_API_KEY=        # Cartesia Ink  — https://play.cartesia.ai/keys
# OPENAI_API_KEY=          # hosted whisper-1

# Pin one provider instead of auto-selecting (sahara|khaya|cartesia|openai|local).
# This is how you demo the same utterance through two models back to back.
# STT_PROVIDER=sahara
# WHISPER_LOCAL_MODEL=base   # base is fast; use medium/large-v3 for final benchmark runs
# CARTESIA_STT_MODEL=ink-whisper

# ── Text-to-speech (spoken replies) ──────────────────────────────────────────
# Reuses INTRON_API_KEY and CARTESIA_API_KEY above — no extra keys to get.
# With neither set the agent simply replies in text, exactly as it did before
# it had a voice.
#
# When the agent speaks:
#   mirror (default) — voice note in, voice note out; typed in, typed out
#   always           — speak every reply, including to typed messages
#   off              — never speak
# TTS_MODE=mirror

# With KHAYA_API_KEY set, a Twi or Ewe voice note gets its reply translated
# into that language (Khaya MT) and spoken by a real Twi/Ewe voice (Khaya TTS).
# The stored reply text stays English; messages.spoken_body records the words
# actually said. Any failure falls back to the English-voice chain below.
# KHAYA_TTS_SPEAKER=female   # male_low | male_high | female

# Pin one voice (khaya|intron|cartesia), or reorder the chain while keeping fallback.
# Measured 5 Aug 2026 on a one-sentence reply: Intron 17–25s, Cartesia 2.8s.
# Intron leads by default because a West African voice is worth the wait on an
# asynchronous channel; flip the order if your patients disagree.
# TTS_PROVIDER=intron
# TTS_ORDER=cartesia,intron

# How long to wait on Intron before switching voices. Its own sync endpoint
# gives up at 120s with a 503, so anything near that means the patient pays two
# minutes of silence for a reply Cartesia produces in one second — which is
# exactly what happened during their 5 Aug 2026 backlog. 20s covers healthy
# Intron (8.9s–25s observed) and caps the loss when it isn't.
# INTRON_TTS_TIMEOUT_S=20

# Circuit breaker: after this many consecutive failures a provider is skipped
# for the cooldown, so an outage costs the wait once instead of once per reply.
# In-memory and per-instance by design — a cold serverless instance retries, so
# a recovered provider is never benched indefinitely.
# TTS_TRIP_AFTER=2
# TTS_COOLDOWN_S=600

# Intron TTS has no Twi, Akan or Ga voice, and no Ghanaian English accent — but
# it does have Pidgin, which a tw-en/gaa-en hint cannot use, so those fall back
# to accented English. Of the ten English accents offered, hausa is the only one
# also spoken in Ghana. See services/tts.py for the full list.
# INTRON_TTS_ACCENT=hausa
# INTRON_TTS_GENDER=female

# Cartesia voices are UUIDs. Browse and preview at https://play.cartesia.ai
# CARTESIA_TTS_VOICE_ID=
# CARTESIA_TTS_MODEL=sonic-3

# Send the text reply alongside the voice note. On by default: the text is the
# durable, forwardable record, the audio is what an unlettered patient needs.
# TTS_WHATSAPP_SEND_TEXT=1

# ── Real WhatsApp (Meta Cloud API) ────────────────────────────────────────────
# Optional — the built-in simulator needs none of this. Setting these makes
# /webhook/whatsapp live, running the same agent logic over a real number.
# Meta for Developers → your app → WhatsApp → API Setup:
# META_ACCESS_TOKEN=       # temporary token, or a permanent System User token
# META_PHONE_NUMBER_ID=    # the Phone Number ID, NOT the phone number itself
# META_VERIFY_TOKEN=       # any random string; paste the same value in the webhook form
# META_APP_SECRET=         # Settings → Basic. Enables signature checks — set in production.

# New patients have not opened WhatsApp's 24-hour service window, so their first
# welcome must use an approved template. Create this template in WhatsApp Manager
# using the exact body documented in docs/WHATSAPP-SETUP.md.
# META_WELCOME_TEMPLATE=veloxacare_welcome
# META_WELCOME_TEMPLATE_LANGUAGE=en_US

# Daily medication reminders are approved templates with three body variables:
# patient first name, medicine, dosage. The hourly cron sends only to patients
# with recorded consent whose configured reminder hour is due.
# META_MEDICATION_REMINDER_TEMPLATE=veloxacare_medication_reminder
# META_MEDICATION_REMINDER_TEMPLATE_LANGUAGE=en_US
# Optional localized approved templates selected from each patient's preferred language:
# META_MEDICATION_REMINDER_TEMPLATE_TWI=veloxacare_medication_reminder_twi
# META_MEDICATION_REMINDER_TEMPLATE_LANGUAGE_TWI=tw
# Equivalent suffixes: GA, EWE, PIDGIN, EN.

# Optional durable staff notification for each newly created escalation. The
# template receives patient name, risk level and case reason.
# META_STAFF_ALERT_TEMPLATE=veloxacare_staff_alert
# META_STAFF_ALERT_TEMPLATE_LANGUAGE=en_US

# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
# Generate a long random value and configure it in the Vercel project.
# CRON_SECRET=

# Language hint for inbound WhatsApp voice notes (en | tw-en | pcm-en | gaa-en | ewe-en).
# WhatsApp doesn't tell us the language, so this is the deployment default.
# WHATSAPP_STT_LANGUAGE=en

# ── Database ──────────────────────────────────────────────────────────────────
# Local runs need none of this: the app opens ./veloxacare.db directly.
#
# Production uses Supabase PostgreSQL. In Supabase, open Connect and copy the
# Transaction pooler connection string (port 6543) for Vercel's serverless
# runtime. Do not paste the https project URL or an API key here.
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:6543/postgres?sslmode=require
# DB_CONNECT_TIMEOUT_S=30

# Use the Session pooler string (port 5432) when applying migrations from an
# IPv4 development machine. Keep this local; Vercel does not need it.
# MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres?sslmode=require

# Legacy only: existing Turso demos can still run while they are migrated, but
# APP_ENV=production deliberately requires DATABASE_URL now.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Override the local SQLite file path. Rarely needed.
# DB_PATH=veloxacare.db
