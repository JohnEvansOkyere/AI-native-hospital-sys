# Copy this to .env and fill in your keys

# Required for AI-powered reason detection and report generation
# Get a free key at https://console.groq.com (cheap + fast)
# This file is a TEMPLATE and is committed — never put a real key here.
GROQ_API_KEY=

# Optional model overrides (defaults are good for the demo)
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_REPORT_MODEL=llama-3.3-70b-versatile

# ── Speech-to-text (voice notes + the code-switch benchmark) ──────────────────
# All optional. With none set, the app falls back to local faster-whisper; with
# nothing at all it degrades to "I couldn't hear that, please type it".
# INTRON_API_KEY=          # Intron Sahara — https://voice.intron.io/v2/developers
# CARTESIA_API_KEY=        # Cartesia Ink  — https://play.cartesia.ai/keys
# OPENAI_API_KEY=          # hosted whisper-1

# Pin one provider instead of auto-selecting (sahara|cartesia|openai|local).
# This is how you demo the same utterance through two models back to back.
# STT_PROVIDER=sahara
# WHISPER_LOCAL_MODEL=base   # base is fast; use medium/large-v3 for final benchmark runs
# CARTESIA_STT_MODEL=ink-whisper

# ── Real WhatsApp (Meta Cloud API) ────────────────────────────────────────────
# Optional — the built-in simulator needs none of this. Setting these makes
# /webhook/whatsapp live, running the same agent logic over a real number.
# Meta for Developers → your app → WhatsApp → API Setup:
# META_ACCESS_TOKEN=       # temporary token, or a permanent System User token
# META_PHONE_NUMBER_ID=    # the Phone Number ID, NOT the phone number itself
# META_VERIFY_TOKEN=       # any random string; paste the same value in the webhook form
# META_APP_SECRET=         # Settings → Basic. Enables signature checks — set in production.

# Language hint for inbound WhatsApp voice notes (en | tw-en | pcm-en | gaa-en).
# WhatsApp doesn't tell us the language, so this is the deployment default.
# WHATSAPP_STT_LANGUAGE=en

# ── Database ──────────────────────────────────────────────────────────────────
# Local runs need none of this: the app opens ./veloxacare.db directly.
#
# Deployed, it does. A serverless filesystem is read-only apart from /tmp, and
# /tmp is per-instance and wiped on cold start — so without Turso a deployed
# demo silently loses every patient reply and every escalation. Set both of
# these in the Vercel dashboard. See docs/DEPLOY.md.
# TURSO_DATABASE_URL=      # libsql://<db>-<org>.turso.io  (`turso db show --url <db>`)
# TURSO_AUTH_TOKEN=        # `turso db tokens create <db>`

# Override the local SQLite file path. Rarely needed.
# DB_PATH=veloxacare.db
