# ── Secrets ───────────────────────────────────────────────────────────────────
# Never commit real keys. .env.example is the template that IS committed.
.env
.env.*
!.env.example
backend/.env

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.log

# ── Runtime data ──────────────────────────────────────────────────────────────
# Demo database re-seeds itself; don't version a moving target.
backend/veloxacare.db
backend/voice_notes/
benchmark/results/
benchmark/manifest.csv

# Recordings are consent-bound patient-adjacent audio — keep them out of git.
# Share deliberately (the challenge's optional audio submission), never by accident.
benchmark/audio/*
!benchmark/audio/.gitkeep

# LibreOffice writes these beside any spreadsheet it has open. One reached a
# commit already; opening summary.csv to read results shouldn't dirty the tree.
.~lock.*#

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Untranscoded originals of the same consent-bound recordings.
benchmark/audio_original/
# Staging area for the optional public dataset. Metadata and the dataset card
# are safe to track; audio is not, and only ships if every speaker ticked the
# release opt-in on the consent form.
benchmark/dataset_release/*.m4a
benchmark/dataset_release/audio/
